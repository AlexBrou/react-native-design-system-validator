{
  "name": "react-native-design-system-validator",
  "private": true,
  "version": "0.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "design:lint": "eslint src",
    "design:render": "playwright test -c design-rules",
    "design:check": "npm run design:lint; npm run design:render",
    "design:report": "playwright show-report .design-report/html",
    "design:device": "node design-rules/device.js",
    "design:check:llm": "node design-rules/check.js",
    "design:hook:on": "node design-rules/hook-toggle.js on",
    "design:hook:off": "node design-rules/hook-toggle.js off",
    "design:hook:status": "node design-rules/hook-toggle.js status"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@material/material-color-utilities": "^0.4.0",
    "expo": "^58.0.22",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0"
  },
  "license": "MIT",
  "description": "A React Native project that runs an automatic Design System validator (using Material Design 3)"
}
